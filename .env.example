# ---------------------------------------------------------------------------
# odoo-mcp-governed — example configuration. Copy to .env and fill in.
# There are no insecure defaults: HTTP mode refuses to start without
# JWT_SECRET (>= 32 chars) and ADMIN_PASSWORD (>= 12 chars).
# ---------------------------------------------------------------------------

# --- Odoo: bootstraps the first profile when data/profiles.json is absent ---
ODOO_URL=http://localhost:65010
ODOO_DB=govtest
ODOO_USERNAME=admin
# Prefer an API key. A password is only needed for get_report (Odoo renders
# reports through a web session, which does not accept API keys).
ODOO_API_KEY=
ODOO_PASSWORD=
ODOO_SSL_VERIFY=true
ODOO_TIMEOUT=30
# production | staging | development. Unset means production, and production
# profiles are READ-ONLY. Label test databases explicitly to write to them.
ODOO_ENVIRONMENT=development
# Lifts read-only on a production profile. Leave false unless you mean it.
ODOO_ALLOW_WRITES=false

# Hosts this server must never connect to, comma-separated. Subdomains are
# covered. On a development machine, list your production ERP here.
PROTECTED_HOSTS=erp.example.com,203.0.113.7

# --- HTTP transport ---
MCP_HOST=0.0.0.0
MCP_PORT=8000
# Public URL shown in the admin panel when behind a reverse proxy.
MCP_PUBLIC_URL=
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
TOKEN_EXPIRY_HOURS=8760
ADMIN_PASSWORD=
ADMIN_SESSION_HOURS=8
# true behind TLS: Secure + __Host- cookie, HSTS.
HTTPS_MODE=false
# Proxies trusted to set X-Forwarded-For (rate limits key on the client IP).
FORWARDED_ALLOW_IPS=127.0.0.1
MAX_BODY_MB=25
RATE_LIMIT_MCP=60/minute
RATE_LIMIT_HEALTH=30/minute
RATE_LIMIT_LOGIN=5/minute

# --- Governance: initial policy. Once edited in the admin panel, the result
# --- is stored in data/policy.json and these become only the starting point.
# One per line in the panel, comma-separated here. "*" means every model
# not on the denylist.
ALLOWED_MODELS=res.partner,product.template,product.product,sale.order,sale.order.line
WRITABLE_MODELS=res.partner
DELETABLE_MODELS=
# Leave unset to use the built-in denylist (ir.cron, ir.actions.server,
# base.automation, ir.config_parameter, res.users.apikeys, ir.rule,
# ir.model.access, ir.mail_server, fetchmail.server, auth.oauth.provider,
# res.config.settings, res.config, ir.module.module and the module wizards).
# DENIED_MODELS=
# Credential fields, as glob patterns. Leave unset for the defaults
# (*_key, *hmac*, *credential*, totp_*, *_pass). Whatever you set here, these
# always apply too: *password* *secret* *token* *api_key* *apikey* *private_key*
# SENSITIVE_FIELDS=*_key,*hmac*,*credential*,totp_*,*_pass,*iban*
DISABLED_TOOLS=
ALLOW_EXECUTE_METHOD=false
EXECUTE_METHOD_ALLOWLIST=action_confirm,message_post
FORBIDDEN_METHODS=
MAX_RECORDS_PER_CALL=500
MAX_ATTACHMENT_MB=10

# --- Governance: detection and risk ---
BUSINESS_HOURS=07:00-20:00
BUSINESS_DAYS=mon,tue,wed,thu,fri,sat
# IANA name, e.g. America/Bogota. Empty = the host's local time.
BUSINESS_TIMEZONE=
RISK_THROTTLE_THRESHOLD=40
RISK_BLOCK_THRESHOLD=70
RISK_THROTTLE_SECONDS=2

# --- Audit log ---
# Strongly recommended: seals the hash chain with an HMAC so that someone with
# only the database file cannot rewrite history undetected.
AUDIT_HMAC_KEY=
DATA_DIR=./data

# --- Misc ---
CACHE_ENABLED=true
CACHE_TTL=300
CACHE_MAX_SIZE=1000
LOG_LEVEL=INFO
# Actor recorded for calls arriving over stdio (Claude Desktop).
STDIO_ACTOR=stdio-local
